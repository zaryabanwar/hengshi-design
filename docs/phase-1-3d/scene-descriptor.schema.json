{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed public scene descriptor v1",
  "description": "Definition-only closed shape. References need semantic manifest/wayfinding/graph validation; this schema grants no serving eligibility or movement readiness. No public endpoint, production asset, budget or dependency version is selected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "stream", "coordinate_frame", "areas", "connections", "destinations"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"$ref": "#/$defs/identifier"},
    "stream": {"enum": ["S-HIGH", "S-MEDIUM", "S-LOW"]},
    "coordinate_frame": {"const": "gltf_y_up_meters"},
    "areas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/area"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "destinations": {"type": "array", "items": {"$ref": "#/$defs/destination"}}
  },
  "$defs": {
    "identifier": {"$ref": "../phase-1-architecture/contracts/publication-manifest.schema.json#/$defs/identifier"},
    "sha256": {"$ref": "../phase-1-architecture/contracts/publication-manifest.schema.json#/$defs/sha256"},
    "scalar": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/scalar"}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/scalar"}},
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["translation", "rotation", "scale"],
      "properties": {
        "translation": {"$ref": "#/$defs/vec3"},
        "rotation": {"$ref": "#/$defs/quaternion"},
        "scale": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"allOf": [{"$ref": "#/$defs/scalar"}, {"not": {"const": 0}}]}}
      }
    },
    "pose": {
      "type": "object", "additionalProperties": false,
      "required": ["translation", "rotation"],
      "properties": {"translation": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/quaternion"}}
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/vec3"}, "max": {"$ref": "#/$defs/vec3"}}
    },
    "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["variant_id", "placement_revision", "interpretation_artifact_id", "visual_artifact_ids", "collision_artifact_ids", "panel_artifact_ids"],
      "properties": {
        "variant_id": {"$ref": "#/$defs/identifier"},
        "placement_revision": {"$ref": "#/$defs/identifier"},
        "interpretation_artifact_id": {"$ref": "#/$defs/identifier"},
        "visual_artifact_ids": {"allOf": [{"$ref": "#/$defs/artifact_ids"}, {"minItems": 1}]},
        "collision_artifact_ids": {"$ref": "#/$defs/artifact_ids"},
        "panel_artifact_ids": {"$ref": "#/$defs/artifact_ids"}
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "interpretation_artifact_id", "bounds"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "interpretation_artifact_id": {"$ref": "#/$defs/identifier"},
        "bounds": {"$ref": "#/$defs/bounds"}
      }
    },
    "node_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "node_index"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "node_index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "purpose", "pose"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/identifier"},
        "purpose": {"enum": ["safe_entry", "crossing_endpoint", "semantic_interaction"]},
        "pose": {"$ref": "#/$defs/pose"},
        "node_binding": {"$ref": "#/$defs/node_binding"},
        "destination_key": {"$ref": "#/$defs/identifier"},
        "route_id": {"$ref": "#/$defs/identifier"}
      },
      "dependentRequired": {"destination_key": ["route_id"], "route_id": ["destination_key"]},
      "if": {"properties": {"purpose": {"const": "semantic_interaction"}}},
      "then": {"required": ["destination_key", "route_id"]}
    },
    "area": {
      "type": "object", "additionalProperties": false,
      "required": ["area_id", "geometry_revision", "role", "placement", "bounds", "bundle", "anchors", "optional_details"],
      "properties": {
        "area_id": {"$ref": "#/$defs/identifier"},
        "geometry_revision": {"$ref": "#/$defs/identifier"},
        "role": {"enum": ["traversable", "scenery"]},
        "placement": {"$ref": "#/$defs/placement"},
        "bounds": {"$ref": "#/$defs/bounds"},
        "bundle": {"$ref": "#/$defs/bundle"},
        "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}},
        "optional_details": {"type": "array", "items": {"$ref": "#/$defs/detail"}}
      },
      "if": {"properties": {"role": {"const": "traversable"}}},
      "then": {
        "properties": {
          "bundle": {"properties": {"collision_artifact_ids": {"minItems": 1}}},
          "anchors": {"contains": {"properties": {"purpose": {"const": "safe_entry"}}, "required": ["purpose"]}, "minContains": 1}
        }
      },
      "else": {
        "properties": {
          "bundle": {"properties": {"collision_artifact_ids": {"maxItems": 0}, "panel_artifact_ids": {"maxItems": 0}}},
          "anchors": {"maxItems": 0}
        }
      }
    },
    "anchor_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["area_id", "anchor_id"],
      "properties": {"area_id": {"$ref": "#/$defs/identifier"}, "anchor_id": {"$ref": "#/$defs/identifier"}}
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["connection_id", "source", "target", "threshold_destination_keys"],
      "properties": {
        "connection_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/anchor_ref"},
        "target": {"$ref": "#/$defs/anchor_ref"},
        "threshold_destination_keys": {"$ref": "#/$defs/artifact_ids"}
      }
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_key", "route_id", "safe_entry", "interactions"],
      "properties": {
        "destination_key": {"$ref": "#/$defs/identifier"},
        "route_id": {"$ref": "#/$defs/identifier"},
        "safe_entry": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/anchor_ref"}]},
        "interactions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/anchor_ref"}}
      }
    }
  }
}
