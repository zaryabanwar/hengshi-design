{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hengshi:v1:company-facts",
  "title": "Prepared company facts v1 — draft shape contract",
  "description": "Typed content subdocument only. Validation cannot verify registration, approve disclosure, activate contacts or authorize publication. Transport/resource bounds and semantic verification remain held.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "legal_name", "registration_jurisdiction"],
  "properties": {
    "schema_version": {"const": 1},
    "legal_name": {"$ref": "#/$defs/text"},
    "registration_jurisdiction": {"$ref": "#/$defs/text"},
    "registered_address": {"$ref": "#/$defs/text"},
    "registrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secp_cuin": {"$ref": "#/$defs/text"},
        "pseb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier"],
          "properties": {
            "identifier": {"$ref": "#/$defs/text"},
            "validity": {"$ref": "#/$defs/monthValidity"}
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact": {"$ref": "#/$defs/text"},
        "privacy": {"$ref": "#/$defs/text"},
        "security": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "public_projection": {
      "description": "Proposed D-076 public-derivative shape only. Excludes deferred registration/address/validity fields; cannot establish fact verification, permitted disclosure, operative contacts, safe rendering or publication authority. Root remains the private prepared-facts shape.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "legal_name", "registration_jurisdiction"],
      "properties": {
        "schema_version": {"const": 1},
        "legal_name": {"$ref": "#/$defs/text"},
        "registration_jurisdiction": {"$ref": "#/$defs/text"},
        "contacts": {"$ref": "#/properties/contacts"}
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\u0000-\u001f\u007f]"}
    },
    "month": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "monthValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "from_month", "through_month"],
      "properties": {
        "precision": {"const": "month"},
        "from_month": {"$ref": "#/$defs/month"},
        "through_month": {"$ref": "#/$defs/month"}
      }
    }
  }
}
