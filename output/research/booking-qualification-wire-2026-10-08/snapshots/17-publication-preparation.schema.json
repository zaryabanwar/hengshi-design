{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed private publication preparation messages v1",
  "description": "Definition-only private job shapes. No endpoint, queue, approval, activation or implementation is selected. Closed messages bind one admitted attempt; semantic identity, authorization, artifact and resource checks remain required.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/prepared"},
    {"$ref": "#/$defs/failed"}
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "candidate_revision", "release_id", "release_created_at",
        "content_snapshot_sha256", "route_plan_sha256", "derivative_plan_sha256",
        "renderer_sha256", "client_build_sha256", "toolchain_lock_sha256",
        "render_config_sha256", "limits_profile_sha256"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/uuid"},
        "candidate_revision": {"$ref": "#/$defs/revision"},
        "release_id": {"$ref": "publication-manifest.schema.json#/$defs/identifier"},
        "release_created_at": {"type": "string", "format": "date-time", "pattern": "Z(?![\\s\\S])"},
        "content_snapshot_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "route_plan_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "derivative_plan_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "renderer_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "client_build_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "toolchain_lock_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "render_config_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"},
        "limits_profile_sha256": {"$ref": "publication-manifest.schema.json#/$defs/sha256"}
      }
    },
    "plan_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "asset_key", "route_ids", "dependencies", "streams"],
      "properties": {
        "artifact_id": {"$ref": "publication-manifest.schema.json#/$defs/identifier"},
        "kind": {"$ref": "publication-manifest.schema.json#/$defs/artifact/properties/kind"},
        "asset_key": {"$ref": "publication-manifest.schema.json#/$defs/asset_key"},
        "route_ids": {"$ref": "publication-manifest.schema.json#/$defs/artifact/properties/route_ids"},
        "dependencies": {"$ref": "publication-manifest.schema.json#/$defs/artifact/properties/dependencies"},
        "streams": {"$ref": "publication-manifest.schema.json#/$defs/artifact/properties/streams"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "preparation_id", "attempt_id", "attempt_generation",
        "binding", "public_snapshot_key", "routes", "expected_artifacts"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "prepare"},
        "preparation_id": {"$ref": "#/$defs/uuid"},
        "attempt_id": {"$ref": "#/$defs/uuid"},
        "attempt_generation": {"$ref": "#/$defs/revision"},
        "binding": {"$ref": "#/$defs/binding"},
        "public_snapshot_key": {"$ref": "publication-manifest.schema.json#/$defs/asset_key"},
        "routes": {"type": "array", "minItems": 1, "items": {"$ref": "publication-manifest.schema.json#/$defs/route"}},
        "expected_artifacts": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/plan_artifact"}}
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "preparation_id", "attempt_id", "attempt_generation", "binding", "envelope"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "prepared"},
        "preparation_id": {"$ref": "#/$defs/uuid"},
        "attempt_id": {"$ref": "#/$defs/uuid"},
        "attempt_generation": {"$ref": "#/$defs/revision"},
        "binding": {"$ref": "#/$defs/binding"},
        "envelope": {"$ref": "publication-manifest.schema.json"}
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "preparation_id", "attempt_id", "attempt_generation", "binding", "failure"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "failed"},
        "preparation_id": {"$ref": "#/$defs/uuid"},
        "attempt_id": {"$ref": "#/$defs/uuid"},
        "attempt_generation": {"$ref": "#/$defs/revision"},
        "binding": {"$ref": "#/$defs/binding"},
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {"enum": ["input_invalid", "authority_unavailable", "candidate_ineligible", "cancelled", "render_failed", "artifact_mismatch", "limit_exceeded", "preparation_unavailable"]},
            "artifact_id": {"$ref": "publication-manifest.schema.json#/$defs/identifier"}
          }
        }
      }
    }
  }
}
