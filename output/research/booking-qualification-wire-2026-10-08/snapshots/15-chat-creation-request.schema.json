{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed private chat creation requests v1",
  "description": "Definition-only IF-CHAT-01 client input. Shape acceptance is not release eligibility, proof/CSRF, consent validity, storage permission or promotion. No handler is implemented.",
  "oneOf": [{"$ref": "#/$defs/bootstrap"}, {"$ref": "#/$defs/create"}],
  "$defs": {
    "identifier": {"$ref": "publication-manifest.schema.json#/$defs/identifier"},
    "operation_id": {"$ref": "booking-creation-request.schema.json#/$defs/operation_id"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256"],
      "properties": {
        "release_id": {"$ref": "#/$defs/identifier"},
        "manifest_sha256": {"$ref": "process-value.schema.json#/$defs/sha256"},
        "wing_key": {"enum": ["ROUTE-WING-STRATEGY", "ROUTE-WING-DIGITAL", "ROUTE-WING-AI-DATA", "ROUTE-WING-IMMERSIVE", "ROUTE-WING-CLOUD-TRUST"]}
      }
    },
    "notice_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_id", "notice_revision", "notice_sha256"],
      "properties": {
        "notice_id": {"$ref": "#/$defs/identifier"},
        "notice_revision": {"$ref": "#/$defs/identifier"},
        "notice_sha256": {"$ref": "process-value.schema.json#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose_key", "notice_reference", "decision"],
      "properties": {
        "purpose_key": {"$ref": "#/$defs/identifier"},
        "notice_reference": {"$ref": "#/$defs/notice_reference"},
        "decision": {"enum": ["grant", "refuse"]}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {"phase": {"const": "bootstrap"}}
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "provisional_id", "operation_id", "context"],
      "properties": {
        "phase": {"const": "create"},
        "provisional_id": {"$ref": "process-value.schema.json#/$defs/uuid"},
        "operation_id": {"$ref": "#/$defs/operation_id"},
        "context": {"$ref": "#/$defs/context"},
        "consent": {"$ref": "#/$defs/consent"}
      }
    }
  }
}
