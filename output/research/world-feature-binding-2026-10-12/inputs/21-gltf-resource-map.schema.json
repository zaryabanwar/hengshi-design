{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed visual glTF resource interpretation v1",
  "description": "Definition-only public shared_asset proposal; selectors do not authorize fetching, decoding or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "stream", "client_build_sha256", "profile_id", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"$ref": "#/$defs/identifier"},
    "stream": {"enum": ["S-HIGH", "S-MEDIUM", "S-LOW"]},
    "client_build_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "identifier": {"$ref": "../phase-1-architecture/contracts/publication-manifest.schema.json#/$defs/identifier"},
    "sha256": {"$ref": "../phase-1-architecture/contracts/publication-manifest.schema.json#/$defs/sha256"},
    "index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "extension_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"},
    "relative_uri": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*(?![\\s\\S])"
    },
    "resource_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "usage"],
      "properties": {
        "location": {"type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/)*uri(?![\\s\\S])"},
        "usage": {"enum": ["buffer", "image", "extension"]}
      }
    },
    "external_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "artifact_id", "uses"],
      "properties": {
        "uri": {"$ref": "#/$defs/relative_uri"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resource_use"}}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "container", "gltf_version", "scene_index", "extensions_used", "extensions_required", "external_resources", "decoder_artifact_ids"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "container": {"enum": ["GLB", "gltf_json"]},
        "gltf_version": {"const": "2.0"},
        "scene_index": {"$ref": "#/$defs/index"},
        "extensions_used": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/extension_name"}},
        "extensions_required": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/extension_name"}},
        "external_resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/external_resource"}},
        "decoder_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    }
  }
}
