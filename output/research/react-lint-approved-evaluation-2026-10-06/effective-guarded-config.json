{
  "settings": {
    "react-hooks": {
      "additionalEffectHooks": "(useSpecialEffect)"
    }
  },
  "linterOptions": {
    "reportUnusedDisableDirectives": 1
  },
  "rules": {
    "react-hooks/rules-of-hooks": [
      2
    ],
    "react-hooks/exhaustive-deps": [
      1
    ],
    "react-hooks/static-components": [
      2
    ],
    "react-hooks/use-memo": [
      2
    ],
    "react-hooks/preserve-manual-memoization": [
      2
    ],
    "react-hooks/incompatible-library": [
      1
    ],
    "react-hooks/immutability": [
      2
    ],
    "react-hooks/globals": [
      2
    ],
    "react-hooks/refs": [
      2
    ],
    "react-hooks/set-state-in-effect": [
      2
    ],
    "react-hooks/error-boundaries": [
      2
    ],
    "react-hooks/purity": [
      2
    ],
    "react-hooks/set-state-in-render": [
      2
    ],
    "react-hooks/unsupported-syntax": [
      1
    ],
    "react-hooks/config": [
      2
    ],
    "react-hooks/gating": [
      2
    ],
    "no-restricted-syntax": [
      2,
      {
        "selector": "ImportDeclaration[source.value='react'] > ImportSpecifier[imported.name=/^use[A-Z0-9]/][local.name!=/^use[A-Z0-9]/]",
        "message": "Keep React Hook import aliases named use followed by an uppercase letter or digit so Hook checks remain enforceable."
      }
    ]
  },
  "plugins": [
    "@",
    "react-hooks:eslint-plugin-react-hooks@7.0.0"
  ],
  "language": "@/js",
  "languageOptions": {
    "sourceType": "module",
    "ecmaVersion": 2026,
    "parser": "typescript-eslint/parser@8.71.1",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    }
  }
}
