        "ROUTE-WING-DIGITAL",
        "ROUTE-WING-AI-DATA",
        "ROUTE-WING-IMMERSIVE",
        "ROUTE-WING-CLOUD-TRUST"
      ]
    },
    "origin": {
      "enum": [
        "handoff",
        "booking"
      ]
    },
    "alert_issue_class": {
      "enum": [
        "OUTCOME_UNKNOWN",
        "ACTION_REQUIRED"
      ]
    },
    "booking_issue_class": {
      "enum": [
        "DUPLICATE",
        "MISSING",
        "MISMATCH",
        "ALERT",
        "NO_SLOTS",
        "OUTCOME_UNKNOWN"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "description": "Parsed integer shape only; raw JSON integer tokens and query ASCII decimals remain separate checks."
    },
    "query_limit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "pattern": "^(?:[1-9]|1[0-9]|2[0-5])(?![\\s\\S])"
    },
    "cursor": {
      "type": "string",
      "minLength": 49,
      "maxLength": 768,
      "pattern": "^q1\\.(?=[A-Za-z0-9_-]{2,683}\\.)(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])",
      "description": "Only lexical canonical unpadded base64url envelope and byte-derived bounds. This does not decode JSON, validate route payload or HMAC, establish an issued cursor, check time/source authority or grant access. A public synthetic zero tag can pass shape."
    },
    "continuation_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
