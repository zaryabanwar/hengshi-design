section{padding:28px 0 45px;border-bottom:1px solid var(--line);scroll-margin-top:12px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{background:#fffdf7;border:1px solid var(--line);border-radius:16px;padding:22px}.tag{display:inline-block;font-size:.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:#e2eadf;color:var(--green);padding:5px 9px;border-radius:6px;margin-bottom:14px}.tag.proposed{background:#efe7d5;color:var(--held)}.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;list-style:none;padding:0;counter-reset:step}.flow li{counter-increment:step;background:#e7ece1;border-radius:12px;padding:20px}.flow li::before{content:counter(step,decimal-leading-zero);display:block;color:var(--muted);font-size:.85rem;margin-bottom:10px}.flow strong{display:block;margin-bottom:8px}.small{font-size:.88rem;color:var(--muted)}figure{margin:22px 0}img{width:100%;height:auto;display:block;border-radius:16px}figcaption{font-size:.9rem;color:var(--muted);padding:12px 0}.wide{grid-column:1/-1}.matrix{width:100%;border-collapse:collapse;font-size:.94rem}.matrix th,.matrix td{padding:14px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}.table-scroll{overflow:auto}details{padding:18px 0;border-top:1px solid var(--line)}summary{cursor:pointer;font-weight:650;padding:8px 0}.callout{border-left:4px solid var(--green);padding:14px 20px;background:#e8eee4}.source-links{display:flex;flex-wrap:wrap;gap:12px 24px}footer{padding-bottom:60px}.two{grid-template-columns:repeat(2,minmax(0,1fr))}
