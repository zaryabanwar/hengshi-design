header,main,footer{max-width:1180px;margin:auto;padding:28px}header{padding-top:48px}h1{font-size:clamp(2.1rem,5vw,3.8rem);line-height:1.1;letter-spacing:-.04em;margin:12px 0 22px}h2{font-size:clamp(1.65rem,3vw,2.3rem);line-height:1.2;margin-top:0}h3{font-size:1.1rem;margin:0 0 10px}p{max-width:78ch}.eyebrow{letter-spacing:.11em;font-size:.78rem;font-weight:700;text-transform:uppercase;color:var(--muted)}
